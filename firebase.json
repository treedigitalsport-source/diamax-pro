{
    "hosting":  {
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**",
                                   "supabase/**",
                                   "turso/**",
                                   "tests/**",
                                   "scratch/**"
                               ],
                    "site":  "diamax-pro",
                    "public":  ".",
                    "headers":  [
                                    {
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache, no-store, must-revalidate"
                                                        }
                                                    ],
                                        "source":  "**"
                                    }
                                ],
                    "rewrites":  [
                                     {
                                         "destination":  "/index.html",
                                         "source":  "**"
                                     }
                                 ]
                }
}
