# ============================================================
# DIAMAX PRO — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# 3Tree Digital Sport IA · CEO Alí Zapata (Lutz, Florida USA)
# ============================================================

# ------------------------------------------------------------
# 1. FRONTEND PUBLIC VARIABLES (INCLUIDAS EN EL CLIENT BUNDLE)
# ------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key-here
VITE_APP_VERSION=2.0.0
VITE_ENVIRONMENT=production

# ------------------------------------------------------------
# 2. SERVER-SIDE ONLY SECRETS (NUNCA EXPONER EN EL CLIENTE)
# ------------------------------------------------------------
# Clave maestra de Supabase para funciones serverless y migraciones
SUPABASE_SERVICE_ROLE_KEY=

# Clave de API de Groq / Llama para inferencia táctica de IA
GROQ_API_KEY=

# Clave de firma privada para autenticación JWT de respaldo
PRIVATE_SIGNING_KEY=

# Cadena de conexión directa a PostgreSQL (Solo CI/CD y Migraciones)
DATABASE_URL=
