rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para autenticación
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Colección de Comentaristas & Narradores Oficiales (commentators)
    match /commentators/{commentatorId} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Colección de Patrocinios Comerciales y Detonadores (broadcast_sponsors)
    match /broadcast_sponsors/{sponsorId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Colección de Ligas y Torneos (leagues)
    match /leagues/{leagueId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.adminId || request.auth.token.role == 'admin');
    }

    // 4. Colección de Juegos Oficiales y Marcador en Vivo (games)
    // Lectura abierta para fanáticos y cabina de comentaristas
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if true; // Anotador oficial en dugout
      
      // Subcolección jugada a jugada (Pitch-by-pitch / WBSC boxScore)
      match /plays/{playId} {
        allow read: if true;
        allow write: if true;
      }
      match /pitches/{pitchId} {
        allow read: if true;
        allow write: if true;
      }
      match /atbats/{atbatId} {
        allow read: if true;
        allow write: if true;
      }
      match /events/{eventId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Compatibilidad adicional matches
    match /matches/{matchId} {
      allow read: if true;
      allow create, update, delete: if true;
      
      match /plays/{playId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // 5. Colección de Simulaciones Monte Carlo & Inteligencia Artificial (simulations)
    match /simulations/{simulationId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // 6. Colección de Usuarios y Acreditaciones Oficiales (users)
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.role == 'admin');
    }

    // Equipos y Rosters
    match /teams/{teamId} {
      allow read: if true;
      allow write: if true;
      
      match /players/{playerId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Torneos
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
